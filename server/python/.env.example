# Copy this file to .env and fill in your values.
# Real environment variables take precedence over values in .env.

# Required: your Stripe secret key (test mode recommended).
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Optional: webhook signing secret, e.g. from `stripe listen --forward-to localhost:4242/webhook`.
# When set, /webhook verifies the Stripe-Signature header.
STRIPE_WEBHOOK_SECRET=whsec_...

# Port the server listens on (default 4242).
PORT=4242

# Public base URL used for the Checkout success_url (default http://localhost:{PORT}).
# DOMAIN=http://localhost:4242

# Directory with the client files, relative to server/python (default ../../client/html).
# STATIC_DIR=../../client/html
