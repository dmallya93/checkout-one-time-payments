# Copy to server/python/.env and fill in your values.
# Real environment variables always take precedence over this file.

# Required: your Stripe secret key (sk_test_..., sk_live_..., rk_test_... or rk_live_...)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me_with_your_key

# Optional: webhook signing secret (whsec_...). Without it the webhook endpoint
# accepts unsigned JSON. Get one with: stripe listen --forward-to localhost:4242/webhook
STRIPE_WEBHOOK_SECRET=

# Optional: port to listen on (default 4242)
# PORT=4242

# Optional: public URL used to build the Checkout success_url (default http://localhost:<PORT>)
# DOMAIN=http://localhost:4242

# Optional: static client directory, relative to server/python/ (default ../../client/html)
# STATIC_DIR=../../client/html

# TEST-ONLY: send Stripe API calls to stripe-mock instead of api.stripe.com.
# Leave unset in development and production; it has no effect when unset.
# STRIPE_API_BASE=http://localhost:12111
